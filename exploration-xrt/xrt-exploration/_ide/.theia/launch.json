{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "xrt-exploration_sw_emu",
      "debugType": "sw_emu",
      "type": "gdb",
      "request": "launch",
      "target": "${workspaceFolder}/xrt-exploration_host/build/x86sim/xrt-exploration_host",
      "applicationProjectDir": "${workspaceFolder}/xrt-exploration",
      "arguments": "-x ${workspaceFolder}/xrt-exploration/build/sw_emu/package/dummy_kernel.xclbin",
      "cwd": "${workspaceFolder}/xrt-exploration/build/sw_emu/xrt-exploration_sw_emu",
      "gdbpath": "${env:XILINX_VITIS}/bin/xgdb",
      "valuesFormatting": "prettyPrinters",
      "env": {
        "XILINX_VITIS": "${env:XILINX_VITIS}",
        "XILINX_HLS": "${env:XILINX_VITIS}",
        "XCL_EMULATION_MODE": "sw_emu",
        "ENABLE_KERNEL_DEBUG": "true",
        "XRT_INI_PATH": "${workspaceFolder}/xrt-exploration/xrt-exploration_host/runtime/sw_emu_xrt.ini",
        "XCL_BIN_PATH": "${workspaceFolder}/xrt-exploration/build/sw_emu/package",
        "LD_LIBRARY_PATH": "${env:XILINX_XRT}/lib"
      }
    },
    {
      "type": "tcf-debug",
      "request": "launch",
      "name": "xrt-exploration_hw_emu",
      "debugType": "tcf_hw_emu",
      "target": {
        "targetConnectionId": "LinuxEmulation",
        "peersIniPath": "../../../.wsdata/.peers.ini",
        "file": "${workspaceFolder}/xrt-exploration_host/build/hw/xrt-exploration_host",
        "remoteFilePath": "/run/media/mmcblk0p1/xrt-exploration_host"
      },
      "env": {
        "XILINX_VITIS": "/run/media/mmcblk0p1",
        "XILINX_XRT": "/usr",
        "XCL_EMULATION_MODE": "hw_emu",
        "XRT_INI_PATH": "/run/media/mmcblk0p1/hw_emu_xrt.ini",
        "LD_LIBRARY_PATH": "/run/media/mmcblk0p1:/tmp:$LD_LIBRARY_PATH"
      },
      "copyToTarget": [
        {
          "source": "${workspaceFolder}/xrt-exploration/build/hw_emu/package/dummy_kernel.xclbin",
          "destination": "/run/media/mmcblk0p1"
        },
        {
          "source": "${workspaceFolder}/xrt-exploration/xrt-exploration_host/runtime/hw_emu_xrt.ini",
          "destination": "/run/media/mmcblk0p1"
        }
      ],
      "copyFromTargetOnTermination": [
        {
          "pattern": ".txt",
          "destination": "${workspaceFolder}/xrt-exploration/build/hw_emu/xrt-exploration_hw_emu"
        },
        {
          "pattern": ".run_summary",
          "destination": "${workspaceFolder}/xrt-exploration/build/hw_emu/xrt-exploration_hw_emu"
        },
        {
          "pattern": ".json",
          "destination": "${workspaceFolder}/xrt-exploration/build/hw_emu/xrt-exploration_hw_emu"
        },
        {
          "pattern": ".csv",
          "destination": "${workspaceFolder}/xrt-exploration/build/hw_emu/xrt-exploration_hw_emu"
        }
      ],
      "pathMap": [
        {
          "source": "/home/tls/heterogeneous-vitis-apps/exploration-xrt/xrt-exploration/build/hw_emu/hw_link/dummy_kernel/dummy_kernel/int/xo/dummy_kernel/dummy_kernel/cpu_sources",
          "destination": "/home/tls/heterogeneous-vitis-apps/exploration-xrt/xrt-exploration_dummy_kernel/src"
        }
      ],
      "replaceNativeEnv": false,
      "arguments": "-x ./dummy_kernel.xclbin",
      "workingDirectory": "/run/media/mmcblk0p1",
      "stopAtMain": true,
      "stopAtProgramEntry": false,
      "autoAttachProcessChildren": false,
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "type": "tcf-debug",
      "request": "launch",
      "name": "xrt-exploration_hw",
      "debugType": "tcf_hw",
      "target": {
        "targetConnectionId": "Linux Agent",
        "peersIniPath": "../../../.wsdata/.peers.ini",
        "file": "${workspaceFolder}/xrt-exploration_host/build/hw/xrt-exploration_host",
        "remoteFilePath": "/run/media/mmcblk0p1/xrt-exploration_host"
      },
      "env": {
        "XILINX_VITIS": "/run/media/mmcblk0p1",
        "XILINX_XRT": "/usr",
        "XRT_INI_PATH": "/run/media/mmcblk0p1/hw_xrt.ini",
        "LD_LIBRARY_PATH": "/run/media/mmcblk0p1:/tmp:$LD_LIBRARY_PATH"
      },
      "copyToTarget": [
        {
          "source": "${workspaceFolder}/xrt-exploration/build/hw/package/dummy_kernel.xclbin",
          "destination": "/run/media/mmcblk0p1"
        },
        {
          "source": "${workspaceFolder}/xrt-exploration/xrt-exploration_host/runtime/hw_xrt.ini",
          "destination": "/run/media/mmcblk0p1"
        }
      ],
      "copyFromTargetOnTermination": [
        {
          "pattern": ".txt",
          "destination": "${workspaceFolder}/xrt-exploration/build/hw/xrt-exploration_hw"
        },
        {
          "pattern": ".run_summary",
          "destination": "${workspaceFolder}/xrt-exploration/build/hw/xrt-exploration_hw"
        },
        {
          "pattern": ".json",
          "destination": "${workspaceFolder}/xrt-exploration/build/hw/xrt-exploration_hw"
        },
        {
          "pattern": ".csv",
          "destination": "${workspaceFolder}/xrt-exploration/build/hw/xrt-exploration_hw"
        }
      ],
      "pathMap": [
        {
          "source": "/home/tls/heterogeneous-vitis-apps/exploration-xrt/xrt-exploration/build/hw/hw_link/dummy_kernel/dummy_kernel/int/xo/dummy_kernel/dummy_kernel/cpu_sources",
          "destination": "/home/tls/heterogeneous-vitis-apps/exploration-xrt/xrt-exploration_dummy_kernel/src"
        }
      ],
      "replaceNativeEnv": false,
      "arguments": "-x ./dummy_kernel.xclbin",
      "workingDirectory": "/run/media/mmcblk0p1",
      "stopAtMain": true,
      "stopAtProgramEntry": false,
      "autoAttachProcessChildren": false,
      "internalConsoleOptions": "openOnSessionStart"
    }
  ]
}