#!/bin/bash
if [[ "$0" == *"++" ]]; then
  COMP="/usr/bin/x86_64-linux-gnu-g++-15"
  FLAGS=""
else
  COMP="/usr/bin/x86_64-linux-gnu-gcc-15"
  FLAGS="-std=gnu17"
fi
exec "$COMP" $FLAGS -Wno-error=incompatible-pointer-types -Wno-error=implicit-function-declaration -Wno-error=implicit-int -Wno-error=int-conversion "$@"
